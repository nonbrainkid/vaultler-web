// VAULTLER — схема БД (прод: Vercel Postgres).
// На M1 локально используется файловый стор (lib/store-file.ts); этот Prisma-стор
// (lib/store-prisma.ts) включается автоматически, когда выставлен DATABASE_URL.

generator client {
  provider = "prisma-client-js"
  output   = "../lib/generated/prisma"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Player {
  id           String   @id @default(cuid())
  // Идентичность: на M1 — dev-session id; на M2 — адрес кошелька (lowercase).
  identity     String   @unique
  stack        Float    @default(0)
  streak       Int      @default(0)
  lastCrankAt  BigInt? // epoch ms
  lastSettleAt BigInt // epoch ms
  machineOn    Boolean  @default(false)
  // Холдерский буст: уровень ступени лестницы HOLDER_TIERS (0 — не холдит) и доля игрока
  // в эмиссии токена в ppb на момент последнего чтения чейна. Ставит только сервер.
  // Долю храним, чтобы показывать прогресс до следующей ступени без запроса к RPC
  // и чтобы при разборе спора было видно, ПОЧЕМУ выдан именно этот множитель.
  boostTier    Int      @default(0)
  boostPpb     Int      @default(0)
  // Недельный борд: ранг считается по приросту `stack - weekStartStack`, а не по
  // накопленному стеку. Личный стек и тиры при этом не сбрасываются.
  weekId         Int   @default(0)
  weekStartStack Float @default(0)
  // Ник для лидерборда: nickname — как показывать, nicknameKey — lowercase для уникальности.
  nickname     String?
  nicknameKey  String?  @unique
  // Скрыть адрес кошелька на борде (по умолчанию открыт для прозрачности).
  hideWallet   Boolean  @default(false)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  crankLogs CrankLog[]

  @@index([stack])
}

// Результаты завершённых недель — то, по чему делается ручная выплата пула.
//
// Без этой таблицы список победителей исчезает в момент сброса борда: ранг считается на
// лету как `stack - weekStartStack`, а база перезаписывается внутри settle при первом же
// обращении игрока после субботней полуночи. Запись делается в той же транзакции, что и
// перевод игрока на новую неделю (lib/store-prisma.ts) — иначе журнал разошёлся бы с тем,
// что он описывает, ровно как это было бы с CrankLog.
//
// rank и share проставляются финализацией недели (app/api/admin/close-week): место —
// свойство всей таблицы, при закрытии игрока по одному оно неизвестно.
model WeekResult {
  id       String  @id @default(cuid())
  weekId   Int
  // Internal id (wallet:0x… / dev:uuid). Наружу не отдаётся никогда — только address.
  identity String
  // Адрес на момент закрытия недели: по нему уходит выплата. null — игрок без кошелька.
  address  String?
  // Прирост стека за неделю, по нему ранжируют.
  gain     Float   @default(0)
  // Место в призовой зоне (1…10). null — вне денег или неделя ещё не финализирована.
  rank     Int?
  // Подтверждённый кошелёк: только такие места делят пул (lib/week-results.ts).
  eligible Boolean @default(false)
  // Доля пула для места (0…1), перенормированная на фактическое число занятых мест.
  share    Float   @default(0)
  // Хеш транзакции выплаты. Проставляется вручную после отправки токенов — код деньги
  // не отправляет by design (docs/security.md).
  payoutTx String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Идемпотентность: повторное закрытие недели (ретрай крона, повторный прогон скрипта)
  // не должно задваивать участника.
  @@unique([weekId, identity])
  @@index([weekId, rank])
}

// Аудит кранков — для анти-чита и разбора спорных ситуаций («у меня было больше стека»).
// Пишется в той же транзакции, что и стейт игрока (lib/store-prisma.ts), иначе журнал
// мог бы разойтись с тем, что он описывает.
//
// Записываются только УСПЕШНЫЕ кранки. Отклонённые (фаза winding) не логируем осознанно:
// они ничего не меняют в стейте — спорить не о чем, — а клиент, поллящий кранк, при
// лимите 1/сек нагенерил бы до 86400 строк в сутки на игрока.
model CrankLog {
  id         String   @id @default(cuid())
  player     Player   @relation(fields: [playerId], references: [id], onDelete: Cascade)
  playerId   String
  at         BigInt // серверный epoch ms кранка
  ok         Boolean // прошёл ли кранк валидацию фазы
  phase      String // фаза на момент попытки (до завода)
  streak     Int // стрик после кранка
  stack      Float // стек после кранка — точка отсчёта при разборе спора
  lostToRaid Float? // сколько скимнул рейдер в этом же settle; null — рейда не было
  createdAt  DateTime @default(now())

  @@index([playerId, at])
}
