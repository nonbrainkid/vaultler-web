# ── VAULTLER env ── скопируй в .env.local (dev) и выстави в Vercel (prod) ──

# [server] Стойкий секрет для подписи сессионных cookie. ОБЯЗАТЕЛЬНО в проде (≥16 симв).
#   Без него приложение в production намеренно падает. Сгенерировать: openssl rand -base64 32
SESSION_SECRET=

# [server] Домен для проверки SIWE-подписи (host без схемы, напр. vaultler-web.vercel.app).
#   ОБЯЗАТЕЛЬНО в проде: без него /api/auth/verify отвечает 500. Host-заголовок присылает
#   сам запрос — проверять подпись против него значит не проверять ничего. Локально пусто = Host.
AUTH_DOMAIN=

# [server, только самохостинг] Доверять заголовку X-Forwarded-For для rate-limit.
#   Ставить 1 ТОЛЬКО если перед приложением стоит прокси, который перезаписывает этот
#   заголовок. На Vercel не нужно (там свой доверенный x-vercel-forwarded-for).
#   Проверка: /api/health → clientIp: "trusted".
TRUST_PROXY_XFF=

# [server] Postgres. Пусто локально → используется файловый стор (.data/players.json).
#   В проде обязателен (Vercel Postgres). Без него в production приложение падает намеренно.
DATABASE_URL=

# ── Общий стор для rate-limit (Vercel KV или Upstash Redis) ──
# Пусто → счётчики живут в памяти инстанса, а на serverless инстансов много: лимит
# обходится размазыванием запросов. Обязательно до раздачи реальных призов.
# Vercel KV подставляет эту пару сам; для Upstash можно задать UPSTASH_REDIS_REST_*.
KV_REST_API_URL=
KV_REST_API_TOKEN=

# [server] Кошельки команды через запятую: играют как все, но в борд и призовой пул
# не попадают. На сайте написано «nothing goes to the team» — кошелёк команды в топ-10
# этому прямо противоречит. Наружу список не отдаётся.
BOARD_EXCLUDE=

# [server] Секрет для POST /api/admin/close-week — финализации недели (≥16 симв.).
#   Роут собирает список победителей и доли пула; денег он не отправляет. Пусто → роут
#   отвечает 503, а не «ок, но ничего не делаю»: молчаливо неработающая финализация
#   обнаружилась бы в субботу вечером, когда платить уже пора.
#   Сгенерировать: openssl rand -base64 32
ADMIN_SECRET=
# Чат владельца для алертов безопасности (задача 1.5). Пусто — счётчики считаются,
# но никого не будят. Узнать свой id можно у @userinfobot.
TELEGRAM_ADMIN_CHAT_ID=

# ── Telegram-бот напоминаний (спринт 1.1, docs/brief-engineer.md) ──
# Фича за флагом: все ТРИ переменные ниже обязательны разом, иначе бот выключен целиком
# (см. /api/health → telegram: "off" | "misconfigured" | "on"). Владелец создаёт бота в
# BotFather сам — это его аккаунт, не автоматизируется.

# [server] Токен бота из BotFather (формат 123456789:AAAА-…). НИКОГДА не в репозитории,
#   не в логах, не в текстах ошибок. Добавлен в scripts/check-secrets.mjs отдельным паттерном.
TELEGRAM_BOT_TOKEN=

# [server] Секрет вебхука, ≥32 симв. Используется ДВАЖДЫ: как случайный сегмент пути
#   /api/telegram/webhook/<secret> (URL не угадывается) и как значение secret_token в
#   setWebhook — Telegram прикладывает его заголовком на каждый апдейт, и роут сверяет
#   оба через timingSafeEqual (lib/telegram.ts). Это ГЛАВНЫЙ контроль всей фичи.
#   Сгенерировать: openssl rand -hex 32
TELEGRAM_WEBHOOK_SECRET=

# [server] Секрет крона рассылки (POST /api/telegram/remind), ≥16 симв. Именно
#   CRON_SECRET (не TELEGRAM_CRON_SECRET) — Vercel Cron Jobs сам шлёт
#   "Authorization: Bearer $CRON_SECRET" на каждый запуск из vercel.json, если эта
#   переменная задана в проекте. Сгенерировать: openssl rand -base64 32
CRON_SECRET=

# [публичная, опц.] Переопределение username бота (без @). Дефолт — "vaultler_bot" —
#   задан В КОДЕ (lib/links.ts), тем же способом, что и адрес контракта $VLTR: это
#   публичный факт, а опечатка в поле env-панели уехала бы в прод без ревью. Задавать
#   здесь нужно только для тестового бота (dev/staging) — прод его не требует.
NEXT_PUBLIC_TELEGRAM_BOT_USERNAME=

# ── Веб-пуши / PWA (второй канал напоминаний, спринт 1.2) ──
# Фича за флагом: без ВСЕХ трёх переменных ниже (плюс CRON_SECRET выше — планировщик у обоих
# каналов один) веб-пуши выключены целиком, кнопка на сайте не показывается вовсе.
# Проверка: /api/health → push: "off" | "misconfigured" | "on".
#
# Ключи VAPID — пара P-256, base64url. Сгенерировать СВОИ (в репозиторий они не коммитятся
# ни при каких условиях, docs/deployment.md):
#   node -e "const c=require('node:crypto'),k=c.createECDH('prime256v1');k.generateKeys();console.log('public:',k.getPublicKey().toString('base64url'));console.log('private:',k.getPrivateKey().toString('base64url'))"
#
# [server] Публичный ключ (65 байт). Публичен по своей природе — браузер получает его из
#   GET /api/push/subscribe. Без префикса NEXT_PUBLIC_ намеренно: так фичу можно включить и
#   выключить в рантайме, не пересобирая бандл.
VAPID_PUBLIC_KEY=
# [server] Приватный ключ (32 байта). Секрет: им подписывается право отправлять уведомления
#   нашим подписчикам. Утёк — чужой может писать нашим игрокам «от Vaultler» (фишинг).
VAPID_PRIVATE_KEY=
# [server] Контакт владельца для push-сервисов (mailto:… или https://…). Обязателен: Mozilla
#   отвергает JWT без валидного sub, и без него пуши молча не доходят.
VAPID_SUBJECT=

# [server, DEV ONLY] Демо-тайминги петли (30с завод / 15с grace) вместо 24ч/12ч.
GAME_MODE=

# [server, DEV ONLY] Принудительно включить ВЕРХНЮЮ ступень буста (тест пути без реальной сети).
DEV_FORCE_BOOST=

# ── Robinhood Chain (Arbitrum Orbit L2) ──
# Реальные значения сети (chainId 4663 = 0x1237, публичный RPC, blockscout) лежат
# ДЕФОЛТАМИ в lib/chain.ts — публичный факт должен проходить ревью в git, а не жить
# в поле панели Vercel. Здесь оставляем пусто: заполнять только для локального anvil
# или тестовой сети. Пустая строка в RPC = чтение чейна выключено.
NEXT_PUBLIC_RH_CHAIN_ID=
NEXT_PUBLIC_RH_RPC_URL=
NEXT_PUBLIC_RH_NAME=Robinhood Chain
NEXT_PUBLIC_RH_EXPLORER=

# [server] Ключ 0x Swap API (dashboard.0x.org, бесплатный тариф ~5 RPS) — для встроенного
# обмена с интерфейсным фисом (docs/monetization.md, M1). БЕЗ префикса NEXT_PUBLIC_:
# ключ используется только серверным роутом, иначе его выгребут из бандла и выжгут квоту.
ZEROX_API_KEY=

# ── Токен $VLTR (для холдерского буста, читается on-chain: balanceOf + totalSupply) ──
# Адрес контракта $VLTR по умолчанию задан В КОДЕ (lib/chain.ts) — он публичный факт и
# должен проходить ревью в git, а не жить только в поле панели Vercel. Здесь — только
# переопределение для тестовой сети / локального anvil.
NEXT_PUBLIC_VLTR_ADDRESS=
NEXT_PUBLIC_VLTR_DECIMALS=18
# Абсолютный анти-дуст-минимум. Сам множитель задаётся ДОЛЕЙ в эмиссии
# (лестница HOLDER_TIERS в lib/game.ts), а не этим числом.
NEXT_PUBLIC_VLTR_BOOST_MIN=1

# [опц.] WalletConnect projectId (бесплатно: cloud.walletconnect.com) — для внешних мобильных кошельков.
NEXT_PUBLIC_WC_PROJECT_ID=
